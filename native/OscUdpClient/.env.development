# Expo CLI reads this file. Uncomment ONE line to force the IPv4 host inside the
# dev-client QR code and deep link (see https://docs.expo.dev/more/expo-cli/#environment-variables).
#
# Android emulator — use with `npm run adb:reverse` (or `npm run start:emu` which runs it):
#REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1
#
# Physical phone on same Wi‑Fi — set to this PC’s IPv4 (run `ipconfig` / `hostname -I`):
#REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.91
