{
  "name": "osc-router-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "PWA sensor router → OSC via WebSocket bridge",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "udp:listen": "node server/udp-listener.js",
    "udp:listen:range": "node server/udp-listener.js --from 9200 --to 9209",
    "start:https": "node server/index.js --https",
    "dev:web": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build:web": "node scripts/generate-icons.mjs && vite build",
    "pwa:lan": "node scripts/pwa-lan.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "osc": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "vite": "^6.0.11"
  }
}
